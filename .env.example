# ==============================================================================
# TradeLab Academy — Environment Configuration
# ==============================================================================
# All external services degrade gracefully when omitted (Local Preview Mode).
# Never expose server-only keys with a VITE_ prefix.

# --- Supabase (Client-safe public keys) ---
# Google (Gmail) OAuth setup in Supabase Dashboard:
#   1. Authentication -> Providers -> Google: enable & add Google OAuth Client ID + Secret.
#   2. Authentication -> URL Configuration -> Redirect URLs:
#      - http://localhost:5173/auth/callback
#      - https://<your-domain>/auth/callback
#   3. Admin promotion (run in Supabase SQL Editor after first Gmail login):
#      UPDATE public.profiles SET role = 'admin' WHERE email = 'your-email@gmail.com';
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (Server-only — Vercel Serverless Functions in /api/*) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Market Data Provider (Server-only — optional) ---
# Free API key for Stocks, Indices, Forex, and Commodities OHLCV candles via /api/market/ohlcv.
# When omitted: Crypto uses public Binance klines; other assets fall back gracefully to the
# public Yahoo Finance chart endpoint or offline deterministic historical sample datasets.
TWELVEDATA_API_KEY=

# --- YouTube Data API v3 (Server-only — optional) ---
# When omitted: manual URL curation still works via public YouTube oEmbed + manual metadata.
YOUTUBE_API_KEY=

# --- AI Mentor Provider (Server-only — optional) ---
# Supported: GEMINI_API_KEY or OPENAI_API_KEY.
# When omitted: falls back cleanly to curated lesson explanations + verified DB resources.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Optional Cron Secret for /api/resources/check-health ---
CRON_SECRET=
